# Application Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# EXTERNAL CLOUD DATABASE CONFIGURATION
# ==============================================================================

# 1. Supabase (PostgreSQL Cloud Database - Recommended)
# Create a free project at https://supabase.com
# Create a table named 'contacts' with columns:
# id (uuid or int8), name (text), email (text), subject (text), message (text), ip (text), created_at (timestamptz)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-service-role-key

# 2. Generic Database Webhook (Optional: Airtable / Firebase / n8n / Custom API)
# EXTERNAL_DATABASE_URL=https://your-api.com/webhook/contact
# EXTERNAL_DATABASE_KEY=your-bearer-token

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
