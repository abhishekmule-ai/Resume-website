# Application Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact Form Delivery Configuration (Configurable Email Service e.g. Resend / SendGrid / SMTP)
CONTACT_EMAIL_RECIPIENT=developer@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
